{
    "name": "markocupic/contao-multifile-download",
    "description": "Together with the Contao Core downloads content element, this extension enables all selected files to be downloaded as a zip archive.",
    "keywords": [
        "contao",
        "content element",
        "multifile",
        "download"
    ],
    "type": "contao-bundle",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Marko Cupic",
            "email": "m.cupic@gmx.ch",
            "homepage": "https://github.com/markocupic/contao-multifile-download",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/markocupic/contao-multifile-download/issues",
        "source": "https://github.com/markocupic/contao-multifile-download"
    },
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.3",
        "symfony/security-bundle": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/dependency-injection": "^6.4"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.3",
        "contao/test-case": "^4.0",
        "phpunit/phpunit": "^8.4",
        "symfony/http-client": "4.4.*",
        "symfony/phpunit-bridge": "4.4.*",
        "contao/easy-coding-standard": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Markocupic\\ContaoMultifileDownload\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Markocupic\\ContaoMultifileDownload\\ContaoManager\\Plugin"
    },
    "version": "2.0.0"
}
